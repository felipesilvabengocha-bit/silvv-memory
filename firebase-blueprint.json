        "responseStyle",
        "depthLevel",
        "toolsEnabled",
        "memoryEnabled",
        "permissionMode",
        "allowedFolderIds",
        "isArchived",
        "createdAt",
        "updatedAt"
      ]
    },
    "AgentSource": {
      "title": "AgentSource",
      "description": "Document uploaded exclusively to a custom agent",
      "type": "object",
      "properties": {
        "id": { "type": "number" },
        "userUid": { "type": "string", "maxLength": 128 },
        "agentId": { "type": "number" },
        "fileName": { "type": "string", "maxLength": 200 },
        "mimeType": { "type": "string", "maxLength": 120 },
        "sizeBytes": { "type": "number" },
        "storagePath": { "type": "string", "maxLength": 512 },
        "aiSummary": { "type": "string", "maxLength": 16000 },
        "extractedText": { "type": "string", "maxLength": 65000 },
        "embedding": { "type": "array" },
        "deletedAt": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userUid", "agentId", "fileName", "mimeType", "sizeBytes", "createdAt", "updatedAt"]
    },
    "AgentMemory": {
      "title": "AgentMemory",
      "description": "Memory learned inside a specific custom agent",
      "type": "object",
      "properties": {
        "id": { "type": "number" },
        "userUid": { "type": "string", "maxLength": 128 },
        "agentId": { "type": "number" },
        "content": { "type": "string", "maxLength": 8000 },
        "category": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userUid", "agentId", "content", "category", "createdAt", "updatedAt"]
    },
    "AgentConversation": {
      "title": "AgentConversation",
      "description": "Isolated conversation thread with a custom agent",
      "type": "object",
      "properties": {
        "id": { "type": "number" },
        "userUid": { "type": "string", "maxLength": 128 },
        "agentId": { "type": "number" },
        "title": { "type": "string", "maxLength": 160 },
        "deletedAt": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userUid", "agentId", "title", "createdAt", "updatedAt"]
    },
    "AgentMessage": {
      "title": "AgentMessage",
      "description": "Message inside a custom agent conversation",
      "type": "object",
      "properties": {
        "id": { "type": "number" },
        "userUid": { "type": "string", "maxLength": 128 },
        "conversationId": { "type": "number" },
        "agentId": { "type": "number" },
        "role": { "type": "string", "enum": ["user", "assistant"] },
        "content": { "type": "string", "maxLength": 65000 },
        "citations": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userUid", "conversationId", "agentId", "role", "content", "citations", "createdAt", "updatedAt"]
    }
  },
