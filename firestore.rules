    }

    function isValidAgentMsg(data) {
      return data.keys().hasAll(['id', 'userUid', 'conversationId', 'agentId', 'role', 'content', 'citations', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'userUid', 'conversationId', 'agentId', 'role', 'content', 'citations', 'createdAt', 'updatedAt'])
