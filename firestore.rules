      match /agentSources/{srcId} {
        allow get: if isOwner(userId) && isValidId(srcId) && (resource == null || existing().userUid == request.auth.uid);
        allow list: if isOwner(userId) && resource.data.userUid == request.auth.uid;
        allow create: if isOwner(userId) && isValidId(srcId) && isValidAgentSource(incoming())
          && incoming().createdAt == request.time && incoming().updatedAt == request.time;
        allow update: if isOwner(userId) && isValidId(srcId) && isValidAgentSource(incoming())
          && incoming().id == existing().id && incoming().userUid == existing().userUid
          && incoming().agentId == existing().agentId
          && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['deletedAt', 'updatedAt']);
        allow delete: if isOwner(userId) && isValidId(srcId) && existing().userUid == request.auth.uid;
      }

      match /agentMemories/{amId} {
        allow get: if isOwner(userId) && isValidId(amId) && (resource == null || existing().userUid == request.auth.uid);
        allow list: if isOwner(userId) && resource.data.userUid == request.auth.uid;
        allow create: if isOwner(userId) && isValidId(amId) && isValidAgentMemory(incoming())
          && incoming().createdAt == request.time && incoming().updatedAt == request.time;
        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(amId) && existing().userUid == request.auth.uid;
      }

      match /agentConversations/{acId} {
        allow get: if isOwner(userId) && isValidId(acId) && (resource == null || existing().userUid == request.auth.uid);
        allow list: if isOwner(userId) && resource.data.userUid == request.auth.uid;
        allow create: if isOwner(userId) && isValidId(acId) && isValidAgentConv(incoming())
          && incoming().createdAt == request.time && incoming().updatedAt == request.time;
        allow update: if isOwner(userId) && isValidId(acId) && isValidAgentConv(incoming())
          && incoming().id == existing().id && incoming().userUid == existing().userUid
          && incoming().agentId == existing().agentId
          && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'deletedAt', 'updatedAt']);
        allow delete: if isOwner(userId) && isValidId(acId) && existing().userUid == request.auth.uid;
      }

      match /agentMessages/{amsgId} {
        allow get: if isOwner(userId) && isValidId(amsgId) && (resource == null || existing().userUid == request.auth.uid);
        allow list: if isOwner(userId) && resource.data.userUid == request.auth.uid;
        allow create: if isOwner(userId) && isValidId(amsgId) && isValidAgentMsg(incoming())
          && incoming().createdAt == request.time && incoming().updatedAt == request.time;
        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(amsgId) && existing().userUid == request.auth.uid;
      }
    }
  }
}
